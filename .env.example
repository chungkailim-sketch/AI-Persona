# ─── RF Persona Intelligence — environment ───────────────────────────────────
# Placeholders only. Never commit real values. Railway injects these per environment.

# Core
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
APP_VERSION=0.1.0

# Database (Railway Postgres provides DATABASE_URL automatically)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Used by `prisma migrate dev` only, to diff the schema safely. Not needed in production.
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_shadow
# Used by the integration test suite only.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@HOST:5432/DATABASE_test

# Sessions — generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-48-byte-random-string
IP_HASH_PEPPER=replace-with-random-string

# AI provider. Leave MODEL_PROVIDER=mock to run with no key at all.
# Set to "anthropic" and supply the key to use the live model. Server-side only.
MODEL_PROVIDER=mock
# Development only: pace each mock call by this many milliseconds (max 5000) so the live screens can
# be watched and end-to-end tested. Changes how long a call takes, never what it returns.
# MOCK_PROVIDER_DELAY_MS=300
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.7
AI_RUN_BUDGET_USD=5
AI_PROJECT_MONTHLY_BUDGET_USD=200

# Email / OTP delivery. "dev" prints the code to the server log and is refused in production.
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=
# For EMAIL_PROVIDER=smtp (e.g. Mailchimp Transactional: smtp.mandrillapp.com, port 587, any
# username; EMAIL_API_KEY is the SMTP password, i.e. a Mandrill API key).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=

# Object storage. "local" writes under .storage/ and is refused in production.
OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Malware scanning. "none" records honestly on each file that no real scan ran.
SCAN_PROVIDER=none

# Queue. "postgres" uses SKIP LOCKED on the Job table; no Redis required at pilot scale.
QUEUE_DRIVER=postgres
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_MS=15000

# Bootstrap: comma-separated approved domains and the first super admin.
BOOTSTRAP_APPROVED_DOMAINS=example.com
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com

# Demonstration sign-in (DEVELOPMENT ONLY).
# A fixed six-digit code for one nominated address, so a demo does not depend on
# reading a terminal. The code is still salted, hashed, expiring and attempt-capped;
# it is simply predictable. The application REFUSES TO START when NODE_ENV=production
# and either of these is set. Leave both empty unless you are running a demonstration.
DEMO_SIGN_IN_EMAIL=
DEMO_SIGN_IN_CODE=

# A folder of Mintel "Global Consumer" databooks (.xlsx). When a demonstration
# credential is configured, signing in with it loads every databook in this folder
# through the ordinary ingest, governance and persona pipeline, once, in the
# background. Refused in production. Leave empty to preload nothing.
DEMO_DATASET_DIR=

# ── TypeSafe System One (judge model, optional) ─────────────────────────────
# Advisory second opinions only. Field NAMES (never values), stimulus text and persona rationales
# are sent to api.typesafe.ai. Sign a data-processing agreement before using client data.
# Never commit a real key. Set it in the host's secret store (e.g. Railway variables).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Comma list: sensitive, stimulus, stance. Empty disables every check.
# `sensitive` sends field names only. Add `stimulus,stance` (client content) after the DPA is signed
# and the governance notice names TypeSafe as a processor.
TYPESAFE_FEATURES=sensitive

# ── TimesFM 2.5 sidecar (optional, see services/timesfm/README.md) ──────────
# Configured → used for backtest evaluation. Forecasts shown only with TIMESFM_APPROVED=true
# (legal + technical sign-off, PRD §24.8 / U3) AND a passing forecast gate.
TIMESFM_URL=
TIMESFM_TOKEN=
TIMESFM_APPROVED=false
